{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "AuctionService",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/AuctionService/bin/Debug/net10.0/AuctionService.dll",
      "cwd": "${workspaceFolder}/src/AuctionService"
    },
    {
      "name": "BiddingService",
      "type": "coreclr",
      "request": "launch",
      "program": "${workspaceFolder}/src/BiddingService/bin/Debug/net10.0/BiddingService.dll",
      "cwd": "${workspaceFolder}/src/BiddingService"
    }
  ],
  "compounds": [
    {
      "name": "Run All Services",
      "configurations": ["AuctionService", "BiddingService"]
    }
  ]
}
